# Public HTTP bind address. Use loopback for a local reverse proxy or tunnel.
YSUDOKU_HTTP_HOST=127.0.0.1
# Public HTTP port for the systemd service.
YSUDOKU_HTTP_PORT=8765
# Dedicated service account created by install.sh.
YSUDOKU_RUN_USER=ysudoku
# Persistent data directory, shared by all users of this service.
YSUDOKU_DATA_DIR=/var/lib/ysudoku
# Shared rules, analysis, frames and quota database.
YSUDOKU_STORE=/var/lib/ysudoku/store
# Local rule and rule-sheet caches.
YSUDOKU_CACHE=/var/lib/ysudoku
# Raw SudokuPad data cache.
SUDOKU_EXPLAIN_CACHE=/var/lib/ysudoku
# History file.
YSUDOKU_HISTORY=/var/lib/ysudoku/history.json
# Read-only curated rules bundled with the active release.
YSUDOKU_RULES=/opt/ysudoku/current/rules

# Default cached rule count before the service has saved storage settings.
YSUDOKU_STORAGE_MAX_RULES=1000
# Default cached analysis count.
YSUDOKU_STORAGE_MAX_STEPS=1000
# Default cached frame-set count.
YSUDOKU_STORAGE_MAX_FRAMES=100
# Default storage threshold in MiB. 0 disables the byte threshold.
YSUDOKU_STORAGE_MAX_MB=500
# Allow clients to change shared storage settings. 1 enables, 0 disables.
YSUDOKU_ALLOW_STORAGE_SETTINGS=1
# Allow clients to delete shared cache layers, puzzles and history.
YSUDOKU_ALLOW_DELETE=1
# When set, allowed shared management requests require this Bearer token.
YSUDOKU_ADMIN_TOKEN=

# Maximum jobs from opening through rendering. 0 disables the limit.
YSUDOKU_MAX_CONCURRENT=0
# Daily solve allowance per IP. 0 disables the limit.
YSUDOKU_DAILY_SOLVES_PER_IP=0
# IANA timezone at whose local midnight daily allowances reset.
YSUDOKU_QUOTA_TIMEZONE=Asia/Shanghai
# Refutation workers. Blank chooses the number automatically.
YSUDOKU_REFUTE_WORKERS=

# LLM provider secret. Leave empty for local rule parsing.
SUDOKU_LLM_API_KEY=
# OpenAI-compatible endpoint base URL.
SUDOKU_LLM_BASE_URL=https://api.deepseek.com
# LLM model name.
SUDOKU_LLM_MODEL=deepseek-flash
# Timeout for each LLM request, in seconds.
SUDOKU_LLM_TIMEOUT=60
# Daily provider input-token allowance shared by all users. 0 means unlimited.
YSUDOKU_DAILY_LLM_INPUT_TOKENS=0
# Daily provider output-token allowance shared by all users. 0 means unlimited.
YSUDOKU_DAILY_LLM_OUTPUT_TOKENS=0

# Trusted TCP peers, as IPs or CIDRs. Blank trusts no forwarder.
YSUDOKU_TRUSTED_PROXIES=
# Single-valued address header from trusted proxies. CF-Connecting-IP or X-Real-IP.
YSUDOKU_PROXY_IP_HEADER=CF-Connecting-IP
# Permanent IP or CIDR bans, separated by commas or spaces.
YSUDOKU_BANNED_IPS=
# Permanent ban list polled every five minutes. Blank disables file-based bans.
YSUDOKU_BAN_FILE=/etc/ysudoku/banned-ips.txt

# Loopback port for the private Playwright worker.
YSUDOKU_LIVE_PORT=8791
# Idle time before recycling Chromium. 0 disables recycling.
YSUDOKU_LIVE_IDLE_SECONDS=600
# Positive values keep the existing browser process warm.
YSUDOKU_LIVE_MIN_IDLE=0
# Optional Chromium executable override. Blank uses the bundled Chromium.
YSUDOKU_CHROME=
# Browser directory maintained by update.sh.
PLAYWRIGHT_BROWSERS_PATH=/var/cache/ysudoku-build/playwright
# Extra Node.js module paths. Blank uses the deployed tools dependency tree.
NODE_PATH=
